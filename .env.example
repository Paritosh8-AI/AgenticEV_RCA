# EV Charge Network CMS Portal Configuration
ELECTREEFI_BASE_URL=https://cms.ev-charge-network.com
ELECTREEFI_LOGIN_URL=https://cms.ev-charge-network.com/Account/Login

# Optional Pre-fill for login form (entered securely or via interactive OTP)
ELECTREEFI_USERNAME=your_cpo_username
ELECTREEFI_PASSWORD=your_secure_password

# Session Storage
SESSION_STORAGE_PATH=data/session_state.json

# Headless Browser Settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# RCA Analysis Configuration
RCA_LOG_TIME_WINDOW_MINUTES=10
RCA_LOW_CONSUMPTION_THRESHOLD_KW=1.0
